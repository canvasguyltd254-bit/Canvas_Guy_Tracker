# Get these from your Supabase project dashboard:
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Email intake (Stage 1) ──────────────────────────────────────────────────
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` automatically once
# this is set — GET /api/email-intake/poll rejects any request without a
# matching header. Generate a random 32+ char string; it is never shown or
# used anywhere else.
CRON_SECRET=

# IMAP credentials for the two enquiry mailboxes, from your hosting cPanel /
# webmail settings (Email Accounts → Connect Devices, or similar). Leave a
# mailbox's vars blank to skip it — the poll route logs it as "not
# configured" rather than failing the whole poll.
EMAIL_CANVAS_GUY_HOST=mail.canvasguy.co.ke
EMAIL_CANVAS_GUY_PORT=993
EMAIL_CANVAS_GUY_USER=info@canvasguy.co.ke
EMAIL_CANVAS_GUY_PASS=

EMAIL_SEATING_COMPANY_HOST=mail.theseatingcompany.co.ke
EMAIL_SEATING_COMPANY_PORT=993
EMAIL_SEATING_COMPANY_USER=info@theseatingcompany.co.ke
EMAIL_SEATING_COMPANY_PASS=

# Key used to encrypt mailbox passwords saved from the CRM "Mailbox logins" screen.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_CREDENTIALS_KEY=
